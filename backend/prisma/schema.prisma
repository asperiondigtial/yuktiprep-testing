// ==========================================
// QUESTION INTELLIGENCE BOUNDED CONTEXT
// ==========================================

enum IngestionSourceType {
  FILE_UPLOAD
  REMOTE_URL
}

enum IngestionQuarantineStatus {
  CLEAN
  SCANNING
  QUARANTINED
  FAILED
}

enum IngestionSourceStatus {
  REGISTERED
  DOWNLOADING
  EXTRACTING
  EXTRACTED
  FAILED
  ARCHIVED
}

enum IngestionStage {
  REGISTRATION
  MALWARE_SCAN
  EXTRACTION
  OCR
  LAYOUT_RECONSTRUCTION
  SEGMENTATION
  CLASSIFICATION
  DEDUPLICATION
  VALIDATION
  COMPLETED
  FAILED
}

enum IngestionJobStatus {
  PENDING
  RUNNING
  SUCCESS
  NEEDS_REVIEW
  FAILED
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  NUMERICAL
  MATCHING
  ASSERTION_REASON
  DESCRIPTIVE
}

enum DuplicateStatus {
  UNIQUE
  EXACT_MATCH
  NEAR_MATCH
  TRANSLATED_MATCH
  CONFLICT_FLAGGED
}

enum DraftReviewStatus {
  PENDING_CORRECTION
  READY_FOR_REVIEW
  ACCEPTED
  REJECTED
  FLAGGED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model IngestionSource {
  id               String                    @id @default(uuid()) @db.Uuid
  name             String                    @db.VarChar(255)
  sourceType       IngestionSourceType       @default(FILE_UPLOAD)
  sourceUrl        String?                   @db.Text
  fileKey          String?                   @db.VarChar(500)
  authority        String                    @db.VarChar(255)
  rights           String                    @default("Public Domain") @db.VarChar(100)
  checksum         String                    @unique @db.VarChar(64)
  mimeType         String                    @default("application/pdf") @db.VarChar(100)
  quarantineStatus IngestionQuarantineStatus @default(CLEAN)
  examId           String?                   @db.Uuid
  metadata         Json?                     @db.JsonB
  extractedText    String?                   @db.Text
  markdownContent  String?                   @db.Text
  status           IngestionSourceStatus     @default(REGISTERED)
  registeredBy     String?                   @db.Uuid
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                  @default(now()) @updatedAt @db.Timestamptz(6)

  exam             Exam?                     @relation(fields: [examId], references: [id])
  adminUser        AdminUser?                @relation(fields: [registeredBy], references: [id])
  jobs             IngestionJob[]
  drafts           QuestionDraft[]

  @@index([authority])
  @@index([status])
  @@index([sourceType])
  @@index([createdAt])
  @@map("ingestion_sources")
}

model IngestionJob {
  id            String             @id @default(uuid()) @db.Uuid
  sourceId      String             @db.Uuid
  stage         IngestionStage     @default(REGISTRATION)
  status        IngestionJobStatus @default(PENDING)
  parserVersion String?            @db.VarChar(50)
  modelVersion  String?            @db.VarChar(50)
  correlationId String?            @db.VarChar(100)
  progress      Float              @default(0.0)
  logs          Json?              @db.JsonB
  error         String?            @db.Text
  startedAt     DateTime?          @db.Timestamptz(6)
  completedAt   DateTime?          @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  source        IngestionSource    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  drafts        QuestionDraft[]

  @@index([sourceId])
  @@index([status])
  @@index([stage])
  @@map("ingestion_jobs")
}

model QuestionDraft {
  id                     String                     @id @default(uuid()) @db.Uuid
  sourceId               String                     @db.Uuid
  jobId                  String?                    @db.Uuid
  itemKey                String                     @db.VarChar(120)
  pageNumber             Int?
  boundingBox            Json?                      @db.JsonB
  nativeContent          Json?                      @db.JsonB
  passage                String?                    @db.Text
  questionText           String                     @db.Text
  questionType           QuestionType               @default(SINGLE_CHOICE)
  options                Json?                      @db.JsonB
  answerBasis            String?                    @db.Text
  correctAnswer          String?                    @db.VarChar(255)
  academicClassification Json?                      @db.JsonB
  confidenceScores       Json?                      @db.JsonB
  duplicateStatus        DuplicateStatus            @default(UNIQUE)
  duplicateMatchId       String?                    @db.Uuid
  reviewStatus           DraftReviewStatus          @default(READY_FOR_REVIEW)
  reviewerNotes          String?                    @db.Text
  version                Int                        @default(1)
  createdAt              DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                   @default(now()) @updatedAt @db.Timestamptz(6)

  source                 IngestionSource            @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  job                    IngestionJob?              @relation(fields: [jobId], references: [id])
  revisions              QuestionDraftRevision[]
  conflicts              QuestionDuplicateConflict[]

  @@unique([sourceId, itemKey])
  @@index([sourceId])
  @@index([reviewStatus])
  @@index([duplicateStatus])
  @@map("question_drafts")
}

model QuestionDraftRevision {
  id           String        @id @default(uuid()) @db.Uuid
  draftId      String        @db.Uuid
  version      Int
  snapshot     Json          @db.JsonB
  changedBy    String?       @db.Uuid
  changeReason String?       @db.VarChar(255)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  draft        QuestionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId, version])
  @@map("question_draft_revisions")
}

model QuestionDuplicateConflict {
  id                String        @id @default(uuid()) @db.Uuid
  draftId           String        @db.Uuid
  matchedEntityId   String        @db.Uuid
  similarityScore   Float
  matchType         String        @db.VarChar(50)
  differenceSummary Json?         @db.JsonB
  resolution        String        @default("UNRESOLVED") @db.VarChar(50)
  resolvedBy        String?       @db.Uuid
  resolvedAt        DateTime?     @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @db.Timestamptz(6)

  draft             QuestionDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@index([draftId])
  @@index([resolution])
  @@map("question_duplicate_conflicts")
}

model QuestionOutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateType String       @default("QUESTION_INTELLIGENCE") @db.VarChar(100)
  aggregateId   String       @db.Uuid
  eventType     String       @db.VarChar(100)
  payload       Json         @db.JsonB

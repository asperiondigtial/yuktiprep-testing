  difficulty     String             @default("MEDIUM") @db.VarChar(50) // "EASY" | "MEDIUM" | "HARD"
  exam           String             @db.VarChar(255) // e.g. "UPSC Civil Services"
  type           String             @default("mock") @db.VarChar(50) // "mock" | "previous-year"
  description    String?            @db.Text
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  questions      MockTestQuestion[]
  attempts       MockTestAttempt[]

  @@index([exam])
  @@index([difficulty])
  @@index([type])
  @@map("mock_tests")
}

model MockTestQuestion {
  id            String   @id @default(uuid()) @db.Uuid
  testId        String   @db.Uuid
  orderIndex    Int      @default(0)
  question      String   @db.Text
  options       Json     @db.JsonB // Array of { id: "A", text: "..." }
  correctAnswer String   @db.VarChar(50) // "A" | "B" | "C" | "D"
  explanation   String?  @db.Text
  createdAt     DateTime @default(now()) @db.Timestamptz(6)

  test          MockTest @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@map("mock_test_questions")
}

model MockTestAttempt {
  id           String    @id @default(uuid()) @db.Uuid
  testId       String    @db.Uuid
  userId       String?   @db.Uuid
  title        String    @db.VarChar(500)
  exam         String    @db.VarChar(255)
  score        String    @db.VarChar(50) // e.g. "73%"
  correct      String    @db.VarChar(50) // e.g. "29/40"
  status       String    @default("Submitted") @db.VarChar(50)
  badge        String    @default("AI") @db.VarChar(50)
  userAnswers  Json      @default("{}") @db.JsonB // { [questionId]: "A" }
  timeTakenSec Int       @default(0)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  test         MockTest  @relation(fields: [testId], references: [id], onDelete: Cascade)

  @@index([testId])
  @@index([userId])
  @@map("mock_test_attempts")
}

// ==========================================
// COMMUNITY & REAL-TIME DISCUSSIONS
// ==========================================

model CommunityPost {
  id            String             @id @default(uuid()) @db.Uuid
  userId        String?            @db.Uuid
  author        String             @db.VarChar(150)
  avatarLetter  String             @default("Y") @db.VarChar(5)
  authorTier    String             @default("FREE") @db.VarChar(50)
  topic         String             @default("General") @db.VarChar(100)
  title         String             @db.VarChar(500)
  content       String             @db.Text
  isPremiumOnly Boolean            @default(false)
  likesCount    Int                @default(0)
  commentsCount Int                @default(0)
  createdAt     DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime           @default(now()) @updatedAt @db.Timestamptz(6)

  comments      CommunityComment[]
  likes         CommunityLike[]
  notifications CommunityNotification[]

  @@index([userId])
  @@index([topic])
  @@index([isPremiumOnly])
  @@index([createdAt])
  @@index([likesCount])
  @@map("community_posts")
}

model CommunityComment {
  id           String        @id @default(uuid()) @db.Uuid
  postId       String        @db.Uuid
  userId       String?       @db.Uuid
  author       String        @db.VarChar(150)
  avatarLetter String        @default("Y") @db.VarChar(5)
  authorTier   String        @default("FREE") @db.VarChar(50)
  content      String        @db.Text
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)

  post          CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  notifications CommunityNotification[]

  @@index([postId])
  @@index([createdAt])
  @@map("community_comments")
}

model CommunityLike {
  id        String        @id @default(uuid()) @db.Uuid
  postId    String        @db.Uuid
  userId    String?       @db.Uuid
  ipHash    String?       @db.VarChar(100)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)

  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@map("community_likes")
}

model CommunityNotification {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  postId          String   @db.Uuid
  commentId       String   @db.Uuid
  actorName       String   @db.VarChar(150)
  actorAvatar     String?  @default("Y") @db.VarChar(10)
  postTitle       String   @db.VarChar(500)
  commentPreview  String?  @db.Text
  type            String   @default("DISCUSSION_COMMENT") @db.VarChar(50)
  parentCommentId String?  @db.Uuid
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now()) @db.Timestamptz(6)

  post            CommunityPost    @relation(fields: [postId], references: [id], onDelete: Cascade)
  comment         CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@index([type])
  @@map("community_notifications")
}

// ==========================================
// SUPPORT TICKETS & PROBLEM REPORTING
// ==========================================

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
  BOTH
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  AWAITING_USER
  RESOLVED
  CLOSED
}

enum TicketPriority {
  P1
  P2
  P3
  P4
}

enum TicketSource {
  CONTACT_FORM
  PROBLEM_REPORT
}

model Ticket {
  id                     String             @id @default(uuid()) @db.Uuid
  ticketNumber           String             @unique @db.VarChar(50)
  userId                 String?            @db.Uuid
  fullName               String             @db.VarChar(255)
  email                  String             @db.VarChar(255)
  mobileNumber           String             @db.VarChar(30)
  persona                String?            @db.VarChar(100)
  examCategory           String?            @db.VarChar(100)
  state                  String?            @db.VarChar(100)
  specificExam           String?            @db.VarChar(100)
  helpCategory           String             @db.VarChar(150)
  subject                String             @db.VarChar(255)
  description            String             @db.Text
  preferredLanguage      String?            @db.VarChar(50)
  preferredContactMethod String?            @db.VarChar(50)
  bestTimeToContact      String?            @db.VarChar(50)
  consent                Boolean            @default(true)
  marketingConsent       Boolean            @default(false)

  problemType            String?            @db.VarChar(150)
  examination            String?            @db.VarChar(255)
  examSubject            String?            @db.VarChar(255)
  chapter                String?            @db.VarChar(255)
  topic                  String?            @db.VarChar(255)
  questionId             String?            @db.VarChar(100)
  explanation            String?            @db.Text

  priority               TicketPriority     @default(P3)
  assignedTeam           String             @default("Customer Support") @db.VarChar(150)
  status                 TicketStatus       @default(OPEN)
  source                 TicketSource       @default(CONTACT_FORM)

  attachments            TicketAttachment[]
  events                 TicketEvent[]
  notificationLogs       NotificationLog[]

  createdAt              DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime           @default(now()) @updatedAt @db.Timestamptz(6)
  resolvedAt             DateTime?          @db.Timestamptz(6)
  closedAt               DateTime?          @db.Timestamptz(6)

  @@index([ticketNumber])
  @@index([status])
  @@index([priority])
  @@index([assignedTeam])
  @@map("tickets")
}

model TicketAttachment {
  id         String   @id @default(uuid()) @db.Uuid
  ticketId   String   @db.Uuid
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  filename   String   @db.VarChar(255)
  storageKey String   @db.VarChar(500)
  mimeType   String   @db.VarChar(100)
  fileSize   Int
  createdAt  DateTime @default(now()) @db.Timestamptz(6)

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketEvent {
  id          String   @id @default(uuid()) @db.Uuid
  ticketId    String   @db.Uuid
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  eventType   String   @db.VarChar(100)
  actorUserId String?  @db.Uuid
  oldValue    String?  @db.VarChar(255)
  newValue    String?  @db.VarChar(255)
  message     String?  @db.Text
  createdAt   DateTime @default(now()) @db.Timestamptz(6)

  @@index([ticketId])
  @@map("ticket_events")
}

model SupportTeam {
  id                  String              @id @default(uuid()) @db.Uuid
  teamName            String              @unique @db.VarChar(150)
  email               String              @db.VarChar(255)
  whatsappNumber      String              @db.VarChar(30)
  notificationChannel NotificationChannel @default(BOTH)
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("support_teams")
}

model NotificationLog {
  id                String              @id @default(uuid()) @db.Uuid
  ticketId          String              @db.Uuid
  ticket            Ticket              @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  channel           NotificationChannel
  recipient         String              @db.VarChar(255)
  status            String              @db.VarChar(50)
  providerMessageId String?             @db.VarChar(255)
  attemptCount      Int                 @default(1)
  errorMessage      String?             @db.Text
  sentAt            DateTime?           @db.Timestamptz(6)
  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @default(now()) @updatedAt @db.Timestamptz(6)

  @@index([ticketId])
  @@index([status])
  @@map("notification_logs")
}

// ==========================================
// METERING & AI GATEWAY TABLES
// ==========================================

model MeteringControl {
  id        Int      @id @default(autoincrement())
  paused    Boolean  @default(false)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("metering_controls")
}

model MeteringControlAudit {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(100)
  evidence  String   @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("metering_control_audit")
}

model MeteringSchemaVersion {
  version Int @id

  @@map("metering_schema_version")
}

model MeteringSubscription {
  userId    String   @id @db.VarChar(128)
  plan      String   @db.VarChar(50)
  period    String   @db.VarChar(128)
  starts    Int      @db.Integer
  ends      Int      @db.Integer
  active    Boolean  @default(true)
  revision  Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  wallets           MeteringWallet[]
  featureUsages     MeteringFeatureUsage[]
  requests          MeteringRequest[]
  featureBonuses    MeteringFeatureBonus[]

  @@index([userId])
  @@map("metering_subscriptions")
}

model MeteringWallet {
  userId    String @db.VarChar(128)
  period    String @db.VarChar(128)
  cap       Int    @default(0)
  spent     Int    @default(0)
  held      Int    @default(0)
  bonus     Int    @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  subscription MeteringSubscription @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, period])
  @@index([userId])
  @@map("metering_wallets")
}

model MeteringGlobalWallet {
  period    String  @id @db.VarChar(128)
  cap       Int
  spent     Int     @default(0)
  held      Int     @default(0)
  blocked   Int     @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("metering_global_wallets")
}

model MeteringFeatureBonus {
  userId    String @db.VarChar(128)
  period    String @db.VarChar(128)
  feature   String @db.VarChar(100)
  bonus     Int    @default(0)

  subscription MeteringSubscription @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, period, feature])
  @@index([userId])
  @@map("metering_feature_bonuses")
}

model MeteringFeatureUsage {
  userId    String @db.VarChar(128)
  period    String @db.VarChar(128)
  feature   String @db.VarChar(100)
  used      Int    @default(0)
  held      Int    @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  subscription MeteringSubscription @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, period, feature])
  @@index([userId])
  @@map("metering_feature_usages")
}

model MeteringRequest {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.VarChar(128)
  idem            String   @db.VarChar(128)
  payloadHash     String   @db.VarChar(64)
  period          String   @db.VarChar(128)
  globalPeriod    String   @db.VarChar(128)
  feature         String   @db.VarChar(100)
  route           String   @db.VarChar(100)
  priceJson       String   @db.Text
  reserved        Int
  actual          Int?
  status          String   @default("reserved") @db.VarChar(50)
  createdAt       Int
  updatedAt       Int
  usageJson       String?
  providerRequestId String? @db.VarChar(255)
  answer          String?
  evidence        String?
  usageTokensJson String?

  subscription MeteringSubscription @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@unique([userId, idem], map: "uq_metering_requests_user_idem")
  @@index([status, createdAt], map: "ix_metering_requests_status_created")
  @@index([userId, createdAt], map: "ix_metering_requests_user_created")
  @@map("metering_requests")
}

model MeteringBillingEvent {
  eventId    String   @id @db.VarChar(128)
  payloadHash String @db.VarChar(64)
  createdAt  Int

  @@map("metering_billing_events")
}

model MeteringRateBucket {
  userId String @db.VarChar(128)
  minute Int
  count  Int     @default(1)

  @@id([userId, minute])
  @@index([userId])
  @@map("metering_rate_buckets")
}

model MeteringInfrastructure {
  eventId   String @id @db.VarChar(128)
  period    String @db.VarChar(128)
  category  String @db.VarChar(100)
  amount    Int
  evidence  String @db.Text
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@map("metering_infrastructure")
}

// ==========================================
// MAINS 360 ATTEMPTS & OCR MAINS TABLES
// ==========================================

model MainsQuestionPaper {
  id               String             @id @default(uuid()) @db.Uuid
  paperName        String             @map("paper_name") @db.VarChar(255)
  paperYear        Int?               @map("paper_year")
  timeLimit        String             @default("3 hours") @map("time_limit") @db.VarChar(50)
  timeLimitMinutes Int                @default(180) @map("time_limit_minutes")
  subjectType      String?            @default("formula_maths") @map("subject_type") @db.VarChar(50)
  totalMarks       Int?               @map("total_marks")
  sourceFilename   String?            @map("source_filename") @db.VarChar(255)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  questions        OcrMainsQuestion[]

  @@map("mains_question_papers")
}

model OcrMainsQuestion {
  id             String              @id @default(uuid()) @db.Uuid
  paperId        String?             @map("paper_id") @db.Uuid
  status         String              @default("SAVED") @db.VarChar(50)
  subjectType    String?             @default("formula_maths") @map("subject_type") @db.VarChar(50)
  examId         String?             @map("exam_id") @db.Uuid
  subjectId      String?             @map("subject_id") @db.Uuid
  questionNumber String?             @map("question_number") @db.VarChar(50)
  section        String?             @db.VarChar(100)
  subheading     String?             @db.VarChar(255)
  textEn         String              @default("") @map("text_en") @db.Text
  textHi         String?             @map("text_hi") @db.Text
  textTa         String?             @map("text_ta") @db.Text
  textTe         String?             @map("text_te") @db.Text
  textKn         String?             @map("text_kn") @db.Text
  latexFormulas  Json?               @default("[]") @map("latex_formulas") @db.JsonB
  subquestions   Json?               @default("[]") @db.JsonB
  diagrams       Json?               @default("[]") @db.JsonB
  tables         Json?               @default("[]") @db.JsonB
  marks          String?             @db.VarChar(50)
  modelAnswer    String?             @map("model_answer") @db.Text
  sourceFilename String?             @map("source_filename") @db.VarChar(255)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  paper          MainsQuestionPaper? @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@map("ocr_mains_questions")
}

model Mains360Attempt {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String?  @map("user_id") @db.Uuid
  paperId          String?  @map("paper_id") @db.VarChar(255)
  paperTitle       String   @map("paper_title") @db.VarChar(500)
  paperCode        String?  @map("paper_code") @db.VarChar(100)
  totalQuestions   Int      @default(0) @map("total_questions")
  attemptedCount   Int      @default(0) @map("attempted_count")
  totalMarks       Float    @default(0) @map("total_marks")
  totalMaxMarks    Float    @default(250) @map("total_max_marks")
  scorePct         Float    @default(0) @map("score_pct")
  timeElapsedMins  Int      @default(0) @map("time_elapsed_mins")
  answersJson      Json     @default("{}") @map("answers_json") @db.JsonB
  evaluationReport Json?    @map("evaluation_report") @db.JsonB
  status           String   @default("SUBMITTED") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([paperId])
  @@index([createdAt])
  @@map("mains_360_attempts")
}

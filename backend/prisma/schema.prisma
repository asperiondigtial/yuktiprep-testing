generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(255)
  passwordHash String
  profilePic   String?
  role         String    @db.VarChar(50)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime? @db.Timestamptz
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @db.Timestamptz

  auditLogs AuditLog[]
  campaigns WhatsAppCampaign[]
  ingestionSources IngestionSource[]
  userAccountActions UserAccountAction[]
}

model TargetExamTitle {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(255)
  slug      String   @unique @db.VarChar(255)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  learnerProfiles LearnerProfile[]
}

model Exam {
  id               String          @id @default(uuid()) @db.Uuid
  name             String          @db.VarChar(255)
  slug             String          @unique @db.VarChar(255)
  shortDescription String?
  description      String?
  logoUrl          String?
  isActive         Boolean         @default(true)
  isPublished      Boolean         @default(false)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  currentAffairs   CurrentAffair[]
  pyqs             PYQ[]
  subjects         Subject[]
  syllabus         Syllabus[]
  ingestionSources IngestionSource[]
  publishedQuestions PublishedQuestion[]
  mainsQuestions   MainsQuestion[]
}

model Subject {
  id             String          @id @default(uuid()) @db.Uuid
  examId         String          @db.Uuid
  name           String          @db.VarChar(255)
  slug           String          @db.VarChar(255)
  description    String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  currentAffairs CurrentAffair[]
  pyqs           PYQ[]
  exam           Exam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  syllabus       Syllabus[]
  topics         Topic[]
  publishedQuestions PublishedQuestion[]
  mainsQuestions MainsQuestion[]

  @@unique([examId, slug])
}

model Topic {
  id          String   @id @default(uuid()) @db.Uuid
  subjectId   String   @db.Uuid
  name        String   @db.VarChar(255)
  slug        String   @db.VarChar(255)
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  pyqs        PYQ[]
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  publishedQuestions PublishedQuestion[]
  mainsQuestions MainsQuestion[]

  @@unique([subjectId, slug])
}

model Syllabus {
  id             String   @id @default(uuid()) @db.Uuid
  examId         String   @db.Uuid
  subjectId      String?  @db.Uuid
  title          String   @db.VarChar(255)
  slug           String   @db.VarChar(255)
  content        String
  seoTitle       String?  @db.VarChar(255)
  seoDescription String?
  canonicalUrl   String?
  status         String   @default("DRAFT") @db.VarChar(50)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  exam           Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject        Subject? @relation(fields: [subjectId], references: [id])
}

model PYQ {
  id            String   @id @default(uuid()) @db.Uuid
  examId        String   @db.Uuid
  subjectId     String?  @db.Uuid
  topicId       String?  @db.Uuid
  question      String
  questionType  String?  @db.VarChar(50)
  options       Json?
  correctAnswer String?
  explanation   String?
  year          Int?
  paper         String?  @db.VarChar(255)
  difficulty    String?  @db.VarChar(50)
  source        String?
  isPublished   Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  exam          Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject       Subject? @relation(fields: [subjectId], references: [id])
  topic         Topic?   @relation(fields: [topicId], references: [id])

  @@index([examId])
  @@index([subjectId])
  @@index([topicId])
  @@index([year])
  @@index([difficulty])
}

model CurrentAffair {
  id             String    @id @default(uuid()) @db.Uuid
  title          String    @db.VarChar(500)
  slug           String    @unique @db.VarChar(500)
  summary        String?
  content        String
  category       String?   @db.VarChar(255)
  examId         String?   @db.Uuid
  subjectId      String?   @db.Uuid
  importance     String?   @db.VarChar(50)
  publishedAt    DateTime? @db.Timestamptz(6)
  lastVerifiedAt DateTime? @db.Timestamptz(6)
  sourceName     String?   @db.VarChar(500)
  sourceUrl      String?
  reviewerName   String?   @db.VarChar(255)
  aiAssistance   Boolean   @default(false)
  status         String    @default("DRAFT") @db.VarChar(50)
  seoTitle       String?   @db.VarChar(255)
  seoDescription String?
  canonicalUrl   String?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  exam           Exam?     @relation(fields: [examId], references: [id])
  subject        Subject?  @relation(fields: [subjectId], references: [id])
}

model SeoPage {
  id             String   @id @default(uuid()) @db.Uuid
  pageType       String   @db.VarChar(100)
  title          String   @db.VarChar(500)
  slug           String   @unique @db.VarChar(500)
  content        String?
  seoTitle       String?  @db.VarChar(255)
  seoDescription String?
  canonicalUrl   String?
  ogTitle        String?  @db.VarChar(255)
  ogDescription  String?
  ogImage        String?
  robotsIndex    Boolean  @default(true)
  robotsFollow   Boolean  @default(true)
  schemaType     String?  @db.VarChar(100)
  status         String   @default("DRAFT") @db.VarChar(50)
  createdAt      DateTime @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @updatedAt @db.Timestamptz(6)
}

model Redirect {
  id         String   @id @default(uuid()) @db.Uuid
  oldPath    String   @unique
  newPath    String
  statusCode Int      @default(301)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
}

model AuditLog {
  id          String     @id @default(uuid()) @db.Uuid
  adminUserId String?    @db.Uuid
  action      String     @db.VarChar(100)
  entityType  String?    @db.VarChar(100)
  entityId    String?    @db.Uuid
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)
  adminUser   AdminUser? @relation(fields: [adminUserId], references: [id])
}

model User {
  id                    String                  @id @default(uuid()) @db.Uuid
  phoneNumber           String?                 @unique @db.VarChar(20)
  email                 String?                 @unique @db.VarChar(255)
  name                  String?                 @db.VarChar(150)
  isVerified            Boolean                 @default(false)
  passwordHash          String?                 @db.VarChar(255)
  role                  String?                 @default("USER") @db.VarChar(50)
  examGroupId           String?                 @db.Uuid
  examOptionId          String?                 @db.Uuid
  examTargets           Json?
  preferredTopics       Json?                   @default("[]")
  language              String?                 @default("en") @db.VarChar(12)
  state                 String?                 @db.VarChar(80)
  difficulty            String?                 @default("mixed") @db.VarChar(20)
  timezone              String?                 @default("Asia/Kolkata") @db.VarChar(64)
  deliveryHour          Int?                    @default(7)
  channels              Json?                   @default("[\"in_app\"]")
  active                Boolean                 @default(false)
  lockedAt              DateTime?               @db.Timestamptz(6)
  lockedBy              String?                 @db.Uuid
  lockReason            String?
  createdAt             DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @db.Timestamptz(6)
  profilePic            String?
  learnerProfile        LearnerProfile?
  consents              Consent[]
  interviewSessions     Session[]
  payments              Payment[]
  savedJobs             SavedJob[]
  subscriptions         Subscription[]
  languagePreference    UserLanguagePreference?
  whatsappConversations WhatsAppConversation[]
  whatsappMessages      WhatsAppMessage[]
  studyPlans            StudyPlan[]
  aiTutorSessions       AiTutorSession[]

  deviceSessions        UserDeviceSession[]
  accountActions        UserAccountAction[]
  mainsAttempts         Mains360Attempt[]
  refundRequests        RefundRequest[]

  examGroup             ExamGroup?              @relation(fields: [examGroupId], references: [id])
  examOption            ExamOption?             @relation(fields: [examOptionId], references: [id])

  @@map("users")
}

model ExamGroup {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @db.VarChar(100)
  slug        String       @unique @db.VarChar(100)
  description String?
  logoUrl     String?
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)

  examOptions ExamOption[]
  users       User[]

  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)

  @@map("exam_groups")
}

model ExamOption {
  id          String      @id @default(uuid()) @db.Uuid
  examGroupId String      @db.Uuid

  title       String      @db.VarChar(255)
  logoUrl     String?

  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)

  examGroup   ExamGroup   @relation(fields: [examGroupId], references: [id], onDelete: Cascade)

  users       User[]

  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  @@index([examGroupId])
  @@map("exam_options")
}

model UserAccountAction {
  id        String    @id @default(uuid()) @db.Uuid

  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  adminId   String    @db.Uuid
  adminUser AdminUser @relation(fields: [adminId], references: [id], onDelete: Restrict)

  action    String    @db.VarChar(50)
  reason    String?

  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([adminId])
  @@index([createdAt])

  @@map("user_account_actions")
}

model UserDeviceSession {
  id               String    @id @default(uuid()) @db.Uuid

  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceId         String    @db.VarChar(255)
  deviceName       String?   @db.VarChar(150)
  deviceType       String?   @db.VarChar(50)

  browser          String?   @db.VarChar(100)
  operatingSystem  String?   @db.VarChar(100)

  ipAddress        String?   @db.Inet
  userAgent        String?

  refreshTokenHash String?   @db.VarChar(255)

  lastActiveAt     DateTime  @default(now()) @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  expiresAt        DateTime? @db.Timestamptz(6)
  revokedAt        DateTime? @db.Timestamptz(6)

  @@unique([userId, deviceId])
  @@index([userId])
  @@index([userId, revokedAt])

  @@map("user_device_sessions")
}


model Language {
  id              String                   @id @default(uuid()) @db.Uuid
  code            String                   @unique
  azureCode       String?                  @unique
  englishName     String                   @db.VarChar(100)
  nativeName      String                   @db.VarChar(100)
  isActive        Boolean                  @default(true)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                 @default(now()) @updatedAt @db.Timestamptz(6)
  userPreferences UserLanguagePreference[]

  @@map("languages")
}

model UserLanguagePreference {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @unique @db.Uuid
  languageId String   @db.Uuid
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  language   Language @relation(fields: [languageId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([languageId])
  @@map("user_language_preferences")
}

model SavedJob {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  jobId     String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("saved_jobs")
}

model LearnerProfile {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @unique @db.Uuid
  targetExamId      String?          @db.Uuid
  attemptYear       Int?
  studyHoursPerDay  Float?
  preferredLanguage String?
  createdAt         DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  targetExam        TargetExamTitle? @relation(fields: [targetExamId], references: [id])
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OtpVerification {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String    @db.VarChar(20)
  purpose    String    @default("LOGIN") @db.VarChar(20)
  otpHash    String    @db.VarChar(255)
  expiresAt  DateTime  @db.Timestamptz(6)
  attempts   Int       @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime? @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @db.Timestamptz(6)

  @@index([phone])
  @@map("otp_verifications")
}

model Item {
  id               String            @id
  eventKey         String            @map("event_key")
  sourceKey        String            @map("source_key")
  sourceName       String            @map("source_name")
  organisation     String
  title            String
  summary          String
  url              String
  publishedAt      DateTime          @map("published_at") @db.Timestamptz(6)
  collectedAt      DateTime          @map("collected_at") @db.Timestamptz(6)
  theme            String
  score            Int
  sourceConfidence Int               @map("source_confidence")
  exams            String[]          @default([])
  examGroups       String[]          @default([]) @map("exam_groups")
  prelims          Int?              @default(1)
  mains            Int?              @default(1)
  pcs              Int?              @default(1)
  ssc              Int?              @default(0)
  banking          Int?              @default(0)
  staticLink       String            @map("static_link")
  itemTranslations ItemTranslation[]

  @@index([publishedAt], map: "ix_items_published")
  @@index([eventKey], map: "ix_items_event_key")
  @@index([theme], map: "ix_items_theme")
  @@map("items")
}

model ItemTranslation {
  id        String            @id @default(uuid())
  itemId    String            @map("item_id")
  language  String            @db.VarChar(12)
  title     String?
  summary   String?
  status    TranslationStatus @default(PENDING)
  provider  String?           @db.VarChar(50)
  attempts  Int               @default(0)
  error     String?
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  item      Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, language], map: "uq_item_translation_item_language")
  @@map("item_translations")
}

model DeadLetter {
  id        Int      @id @default(autoincrement())
  sourceKey String?  @map("source_key")
  stage     String
  reason    String
  payload   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("dead_letters")
}

model SourceRun {
  id          Int       @id @default(autoincrement())
  sourceKey   String    @map("source_key")
  startedAt   DateTime  @map("started_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  success     Boolean   @default(false)
  httpStatus  Int?      @map("http_status")
  foundCount  Int       @default(0) @map("found_count")
  savedCount  Int       @default(0) @map("saved_count")
  error       String?

  @@map("source_runs")
}

model Question {
  id           String   @id
  eventKey     String   @map("event_key")
  theme        String
  exam         String
  questionType String   @map("question_type")
  priority     Int
  question     String
  answerBasis  String   @map("answer_basis")
  sourceUrl    String   @map("source_url")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  answer       String?
  options      Json?

  @@map("questions")
}

model Job {
  id                  String     @id @default(uuid())
  title               String
  department          String
  organization        String
  location            String
  state               String
  category            String
  postDate            String
  lastDate            String
  applyByDate         String?
  qualification       Json
  totalPosts          String
  salary              String?
  ageLimit            String?
  applicationFee      String?
  selectionProcess    String?
  officialPdfUrl      String?
  sourceUrl           String
  status              String
  publicationSource   String?
  employmentType      String?
  examProjectedDate   String?
  expectedResultsDate String?
  uniqueCapabilities  String?
  description         String
  createdAt           DateTime   @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime   @updatedAt @db.Timestamptz(6)
  savedByUsers        SavedJob[]

  @@map("jobs")
}

model Plan {
  id              String         @id @default(uuid()) @db.Uuid
  key             String         @unique @db.VarChar(100)
  name            String         @db.VarChar(255)
  subtitle        String?        @db.VarChar(255)
  price           Int
  currency        String         @default("INR") @db.VarChar(3)
  billingInterval String         @default("monthly") @db.VarChar(20)
  razorpayPlanId  String?        @db.VarChar(255)
  badgeText       String?        @db.VarChar(100)
  badgeType       String?        @db.VarChar(50)
  theme           String?        @db.VarChar(50)
  sortOrder       Int            @default(0)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @db.Timestamptz(6)
  payments        Payment[]
  features        PlanFeature[]
  subscriptions   Subscription[]

  @@index([sortOrder])
  @@index([isActive])
  @@map("plans")
}

model PlanFeature {
  id        String   @id @default(uuid()) @db.Uuid
  planId    String   @db.Uuid
  text      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_features")
}

model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  userId                 String    @db.Uuid
  planId                 String    @db.Uuid
  razorpaySubscriptionId String?   @unique @db.VarChar(255)
  razorpayCustomerId     String?   @db.VarChar(255)
  status                 String    @default("pending") @db.VarChar(50)
  currentStart           DateTime? @db.Timestamptz(6)
  currentEnd             DateTime? @db.Timestamptz(6)
  cancelAtCycleEnd       Boolean   @default(false)
  createdAt              DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @db.Timestamptz(6)
  payments               Payment[]
  refundRequests         RefundRequest[]
  plan                   Plan      @relation(fields: [planId], references: [id])
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  subscriptionId    String          @db.Uuid
  planId            String          @db.Uuid
  razorpayPaymentId String?         @unique @db.VarChar(255)
  amount            Int
  currency          String          @default("INR") @db.VarChar(3)
  status            String          @default("pending") @db.VarChar(50)
  method            String?         @db.VarChar(50)
  rawResponse       Json?
  createdAt         DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime        @default(now()) @updatedAt @db.Timestamptz(6)
  plan              Plan            @relation(fields: [planId], references: [id])
  subscription      Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  refundRequests    RefundRequest[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
  @@map("payments")
}

model RefundRequest {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  subscriptionId   String       @db.Uuid
  paymentId        String       @db.Uuid
  amount           Int          // Amount in currency units or paise matching Payment.amount
  currency         String       @default("INR") @db.VarChar(10)
  reason           String       @db.Text
  adminNote        String?      @db.Text
  status           String       @default("PENDING") @db.VarChar(50) // PENDING, APPROVED, REJECTED, PROCESSED, FAILED
  razorpayRefundId String?      @unique @db.VarChar(100)
  rawResponse      Json?
  reviewedBy       String?      @db.Uuid
  reviewedAt       DateTime?    @db.Timestamptz(6)
  createdAt        DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @db.Timestamptz(6)

  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription     Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  payment          Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([subscriptionId])
  @@index([paymentId])
  @@index([status])
  @@map("refund_requests")
}

model WebhookEvent {
  id              String    @id @default(uuid()) @db.Uuid
  razorpayEventId String    @unique @db.VarChar(255)
  eventType       String    @db.VarChar(100)
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime? @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)

  @@index([razorpayEventId])
  @@index([processed])
  @@map("webhook_events")
}

model Consent {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  version      String    @db.VarChar(50)
  audio        Boolean
  video        Boolean
  aiProcessing Boolean
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)
  revokedAt    DateTime? @db.Timestamptz(6)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("consents")
